# Panamaster — закрываем служебные файлы от интернета.
# Только mod_alias (RedirectMatch) и IfModule — без Options/Require,
# чтобы не получить 500 при ограниченном AllowOverride на хостинге.

# Скрытые файлы и папки: .cursor/, .github/, .gitignore, .cursorignore (кроме .well-known)
RedirectMatch 404 ^/\.(?!well-known/)

# Бот: логи, словари, состояние. webhook.php оставлен доступным для Telegram.
RedirectMatch 404 ^/bot/(?!webhook\.php$)

# Исходники: прокси Worker, шаблоны генерации, данные кейсов, тесты
RedirectMatch 404 ^/(cloudflare|assets/templates|assets/data)/
RedirectMatch 404 ^/(tests|inbox)/

# Служебные расширения
RedirectMatch 404 \.(log|md|mdc|sh|jsonc|yml|yaml|bak|backup|wip)$

# Старый сайт (до 09.2026, бытовая техника): адреса ещё в выдаче поисковиков (решение владельца 09.10.2026).
# Нужные страницы — 301 на новые; остальное — 410 «удалено навсегда», чтобы Яндекс и Google быстрее убрали их.
# Порядок важен: первое совпавшее правило срабатывает. Новые адреса сайта (*.html, папки ниже) не затрагиваются.
RedirectMatch 301 ^/o-kompanii/?$ https://panamaster.ru/about.html
RedirectMatch 301 ^/(kontakty|nashi-kontakty|rekvizity|rekvizity-kompanii)/?$ https://panamaster.ru/contacts.html
RedirectMatch 301 ^/remont-promyshlennoj-elektroniki/?$ https://panamaster.ru/blocks.html
RedirectMatch 301 ^/(service-avtomatizatsiya|service/kompleksnye-tekhnicheskie-uslugi)/?$ https://panamaster.ru/services.html
RedirectMatch 301 ^/(sotrudnichestvo_ru|help-predlozheniya-o-sotrudnichestve)/?$ https://panamaster.ru/manufacturers.html
RedirectMatch 301 ^/(cooperation_en|cooperation_fr|cooperacion_es)/?$ https://panamaster.ru/en/manufacturers.html
# Адреса-папки разделов без index.html отдавали 301 на http://…/ и затем 403 (проверено 10.10.2026).
# Один постоянный редирект сразу на https-страницу раздела; служебные папки (assets, bot) не затрагиваются.
RedirectMatch 301 ^/(services|cases|blocks|blocks/cnc-controls|blocks/drives-servo|blocks/drives-servo/rexroth)/?$ https://panamaster.ru/$1.html
RedirectMatch 301 ^/(en|zh)/?$ https://panamaster.ru/$1/manufacturers.html
RedirectMatch 410 ^/(?!(?:assets|bot|services|blocks|cases|en|zh|cgi-bin|\.well-known)(?:/|$))[^.]+$
RedirectMatch 410 ^/(g|shared|d|t)/

# Кеш браузера (10.10.2026). Картинки и шрифты меняются редко и при замене обычно получают новое имя — 30 дней.
# CSS, JS, HTML, sitemap, search.json подключаются без версии в имени — браузер каждый раз сверяет их с сервером
# (ETag/Last-Modified → 304), поэтому после деплоя посетитель сразу видит новую версию.
<IfModule mod_headers.c>
    <FilesMatch "\.(webp|jpe?g|png|gif|svg|ico|woff2?)$">
        Header set Cache-Control "public, max-age=2592000"
        Header unset Expires
    </FilesMatch>
    <FilesMatch "\.(css|js|html|xml|json|txt)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# test.html пишет бот при тесте деплоя — страница работает, но не индексируется
<IfModule mod_headers.c>
    <Files "test.html">
        Header set X-Robots-Tag "noindex, nofollow"
    </Files>
</IfModule>
